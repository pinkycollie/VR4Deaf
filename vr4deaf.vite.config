/**
 * VR4DEAF.ORG — Environment Factory + Vite Config
 * ══════════════════════════════════════════════════════════════════════════════
 * Separate platform from mbtq.dev.
 *
 * Domain:    vr4deaf.org
 * Purpose:   VR agency-to-Deaf-client platform
 *            Vocational Rehabilitation + Deaf/HoH-first lifecycle delivery
 *
 * Distribution chain (this platform only):
 *   Pinky (root builder — deploys vr4deaf.org)
 *     → VR Agency Admins   (state VR agencies, RSA-911 reporting)
 *       → VR Counselors     (caseload management, client assignments)
 *         → Deaf/HoH Clients (individuals — job seekers, VR candidates)
 *
 * Environments:
 *   vr4deaf_client     Browser · Deaf/HoH individuals on vr4deaf.org
 *   vr4deaf_counselor  Node.js · VR counselor portal · caseload tools
 *   vr4deaf_admin      Node.js · State VR agency · RSA-911 · federal reporting
 *   vr4deaf_edge       Cloudflare workerd · ASL video stream · caption injection
 *
 * Lifecycle (sequential, enforced):
 *   IDEA → PROPOSAL → BUILD → GROW → MANAGED → SUNSET
 *   Maps to VR case flow:
 *   REFERRAL → IPE PLAN → SERVICES → MILESTONES → EMPLOYMENT → CASE CLOSURE
 *
 * Auth:      DeafAUTH PASETO v4 — shared with mbtq.dev trust mesh
 * Video:     PinkSync ASL stream — vr4deaf.org is primary ASL video consumer
 * Reporting: RSA-911 state + federal (ED/RSA)
 * Trust:     FibronRose anchors all case events
 *
 * @separate-from  mbtq.dev  (different domain, different build, different users)
 * @integrated-with  mbtq.dev via @mbtq/magician-core portable module
 *                   PinkSync WebSocket (shared trust mesh)
 *                   DeafAUTH (shared identity layer)
 */

import { defineConfig, loadEnv, mergeConfig } from "vite";
import react from "@vitejs/plugin-react";
import tsconfigPaths from "vite-tsconfig-paths";
import {
  DevEnvironment,
  BuildEnvironment,
  type EnvironmentOptions,
  type ResolvedConfig,
} from "vite";

// ─── VR4DEAF-SPECIFIC TYPES ───────────────────────────────────────────────────

export type VR4DeafTier =
  | "builder"     // Pinky — root deployer
  | "vr_admin"    // State VR agency administrator
  | "counselor"   // VR counselor / case manager
  | "client";     // Deaf/HoH individual receiving VR services

export type VRCaseStage =
  | "referral"         // IDEA   — initial referral, eligibility determination
  | "ipe_plan"         // PROPOSAL — Individualized Plan for Employment drafted
  | "services"         // BUILD  — active VR services: training, placement, tools
  | "milestones"       // GROW   — employment milestones, outcomes tracked
  | "employment"       // MANAGED — competitive integrated employment achieved
  | "case_closure";    // SUNSET — case closed, lifetime support registered

// Maps VR case stages to MBTQ lifecycle stages
export const VR_TO_MBTQ_STAGE: Record<VRCaseStage, string> = {
  referral:      "idea",
  ipe_plan:      "proposal",
  services:      "build",
  milestones:    "grow",
  employment:    "managed",
  case_closure:  "sunset",
};

export type DeafMode = "deaf" | "hoh" | "deafblind" | "coda";

export interface VR4DeafAuditRecord {
  id: string;
  ts: number;
  tier: VR4DeafTier;
  caseNumber: string | null;      // VR case number
  clientId: string | null;        // Deaf/HoH individual
  counselorId: string | null;     // Assigned VR counselor
  agencyCode: string | null;      // State VR agency code (e.g. "CA-DVR")
  vrCaseStage: VRCaseStage;
  action: string;
  deafMode: DeafMode | null;
  pasetoToken: string;
  rsa911Reportable: boolean;      // Whether this record feeds RSA-911
  anchored: boolean;              // FibronRose anchor status
}

export interface VR4DeafReporting {
  stateVREndpoint: string;       // State VR agency reporting endpoint
  rsa911Endpoint: string;        // RSA-911 federal endpoint (ED/RSA)
  pasetoPublicKey: string;
  agencyCode: string;            // e.g. "CA-DVR", "TX-TWC-VR", "NY-ACCES-VR"
  fiscalYear: string;            // e.g. "FY2025"
}

export interface VR4DeafEnvContext {
  tier: VR4DeafTier;
  reporting?: VR4DeafReporting;
  auditLog?: (record: Omit<VR4DeafAuditRecord, "id" | "ts">) => void;
}

// ─── AUDIT SINK ───────────────────────────────────────────────────────────────
const auditQueue: VR4DeafAuditRecord[] = [];

export const vr4deafAuditLog: VR4DeafEnvContext["auditLog"] = (record) => {
  const full: VR4DeafAuditRecord = {
    ...record,
    id: `vr4d_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,
    ts: Date.now(),
  };
  auditQueue.push(full);
  if (process.env.NODE_ENV !== "production") {
    console.log(
      `[VR4DEAF AUDIT] ${full.tier} · ${full.vrCaseStage} · ${full.action}`,
      full.caseNumber ?? "no-case"
    );
  }
};

// ─── RSA-911 REPORT SUBMISSION ────────────────────────────────────────────────
/**
 * Submits RSA-911 formatted case data to:
 *   1. State VR agency endpoint
 *   2. RSA federal endpoint (ED/RSA)
 *
 * RSA-911 collects: demographic data, services received, employment outcomes,
 * case closure reasons, disability categories, costs, staff hours.
 * Deaf/HoH cases: disability code 7 (hearing) + accommodation flag.
 */
export async function submitRSA911(
  records: VR4DeafAuditRecord[],
  reporting: VR4DeafReporting
): Promise<{ state: Response | null; federal: Response | null }> {
  const rsa911Records = records
    .filter((r) => r.rsa911Reportable)
    .map((r) => ({
      caseNumber: r.caseNumber,
      agencyCode: r.agencyCode,
      fiscalYear: reporting.fiscalYear,
      stageCompleted: r.vrCaseStage,
      mbtqLifecycleStage: VR_TO_MBTQ_STAGE[r.vrCaseStage],
      deafMode: r.deafMode,
      timestamp: r.ts,
      anchored: r.anchored,
      // RSA-911 specific fields (populated by case management module):
      disabilityCode: "07",       // Hearing impairment
      accommodationFlag: true,
      interpreterServices: r.deafMode === "deaf" || r.deafMode === "coda",
      captionServices: r.deafMode === "hoh",
      tactileServices: r.deafMode === "deafblind",
    }));

  if (rsa911Records.length === 0) {
    return { state: null, federal: null };
  }

  const payload = JSON.stringify({
    agencyCode: reporting.agencyCode,
    fiscalYear: reporting.fiscalYear,
    submittedAt: new Date().toISOString(),
    recordCount: rsa911Records.length,
    records: rsa911Records,
    platform: "vr4deaf.org",
    dataSource: "mbtq-fibronrose",
  });

  const headers = {
    "Content-Type": "application/json",
    Authorization: `Bearer ${reporting.pasetoPublicKey}`,
    "X-Agency-Code": reporting.agencyCode,
    "X-Fiscal-Year": reporting.fiscalYear,
    "X-Platform": "vr4deaf.org",
    "X-Report-Schema": "RSA-911-v2",
  };

  const [stateRes, federalRes] = await Promise.allSettled([
    fetch(reporting.stateVREndpoint, { method: "POST", headers, body: payload }),
    fetch(reporting.rsa911Endpoint, { method: "POST", headers, body: payload }),
  ]);

  return {
    state: stateRes.status === "fulfilled" ? stateRes.value : null,
    federal: federalRes.status === "fulfilled" ? federalRes.value : null,
  };
}

// ═══════════════════════════════════════════════════════════════════════════════
// VR4DEAF ENVIRONMENT FACTORIES
// ═══════════════════════════════════════════════════════════════════════════════

const vr4deafBase = (): Partial<EnvironmentOptions> => ({
  resolve: {
    conditions: ["vr4deaf", "mbtq", "import", "module", "browser", "default"],
  },
  define: {
    __VR4DEAF__:      "true",
    __VR4DEAF_DOMAIN__: JSON.stringify("vr4deaf.org"),
    __MBTQ_DEAFAUTH__: "true",
    __MBTQ_PINKSYNC__: "true",
    __MBTQ_FIBRONROSE__: "true",
  },
});

// ─── CLIENT ENV — Deaf/HoH Individuals ───────────────────────────────────────
/**
 * The individual Deaf/HoH user experience on vr4deaf.org.
 * - DeafAUTH gate with mandatory Deaf/HoH/DeafBlind mode selection
 * - PinkSync ASL video built-in (not optional)
 * - Caption layer always-on, never opt-in
 * - No audio gates anywhere in the codebase
 * - All alerts: flash-visual only
 * - VR lifecycle: referral → IPE → services → milestones → employment → closure
 */
export function createVR4DeafClientEnvironment(
  userConfig: EnvironmentOptions = {}
): EnvironmentOptions {
  return mergeConfig(
    {
      ...vr4deafBase(),
      resolve: {
        conditions: ["browser", "vr4deaf-client", "mbtq", "import", "default"],
      },
      define: {
        ...vr4deafBase().define,
        __VR4DEAF_TIER__:         JSON.stringify("client" satisfies VR4DeafTier),
        __MBTQ_HOH_CAPABLE__:     "true",
        __MBTQ_ASL_VIDEO__:       "true",
        __MBTQ_AUDIO_OPTIONAL__:  "true",
        __VR4DEAF_CAPTION_ALWAYS_ON__: "true",
        __VR4DEAF_FLASH_ALERTS__: "true",
        // Deaf/HoH mode is mandatory — no "skip" option
        __VR4DEAF_MODE_REQUIRED__: "true",
      },
      dev: {
        createEnvironment(name: string, config: ResolvedConfig) {
          return new DevEnvironment(name, config, { hot: true });
        },
      },
      build: {
        outDir: "dist/vr4deaf/client",
        createEnvironment(name: string, config: ResolvedConfig) {
          return new BuildEnvironment(name, config);
        },
      },
    } satisfies EnvironmentOptions,
    userConfig
  );
}

// ─── COUNSELOR ENV — VR Counselors / Case Managers ───────────────────────────
/**
 * VR counselor portal on vr4deaf.org.
 * - Caseload management: assign clients, track IPE plans, log services
 * - Module generators: spin up lifecycle modules per client case
 * - HotChannel for real-time caseload updates across counselor network
 * - Every case action → auditLog → RSA-911 reportable queue
 * - Integrated with mbtq.dev vendor network (counselors = Tier 2 vendors)
 */
export function createVR4DeafCounselorEnvironment(
  context: VR4DeafEnvContext,
  userConfig: EnvironmentOptions = {}
): EnvironmentOptions {
  return mergeConfig(
    {
      ...vr4deafBase(),
      resolve: {
        conditions: ["node", "vr4deaf-counselor", "mbtq", "import", "default"],
        noExternal: ["deafauth-paseto", "fibronrose-sdk"],
      },
      define: {
        ...vr4deafBase().define,
        __VR4DEAF_TIER__:           JSON.stringify("counselor" satisfies VR4DeafTier),
        __VR4DEAF_CASELOAD__:       "true",
        __VR4DEAF_MODULE_GEN__:     "true",
        __MBTQ_AUDIT_ENABLED__:     "true",
        __MBTQ_LIFECYCLE_SEQUENTIAL__: "true",
        __VR4DEAF_CAPTION_ALWAYS_ON__: "true",
      },
      dev: {
        createEnvironment(name: string, config: ResolvedConfig) {
          return new DevEnvironment(name, config, {
            hot: true,
            // HotChannel for counselor network real-time sync
            // Production: attach createVendorHotChannel from mbtq-environments.ts
          });
        },
      },
      build: {
        outDir: "dist/vr4deaf/counselor",
        ssr: true,
        createEnvironment(name: string, config: ResolvedConfig) {
          return new BuildEnvironment(name, config);
        },
      },
    } satisfies EnvironmentOptions,
    userConfig
  );
}

// ─── ADMIN ENV — State VR Agency ──────────────────────────────────────────────
/**
 * State VR agency administrator portal on vr4deaf.org.
 * - HTTP/HTTPS only (gov network policy — no WebSocket)
 * - RSA-911 reporting: state + federal (ED/RSA)
 * - Case approval: IPE plan review, service authorization, case closure approval
 * - Sunset gate: admin must approve before counselor can close a case
 * - PASETO-signed on every request
 * - FibronRose audit trail anchored to blockchain
 */
export function createVR4DeafAdminEnvironment(
  context: VR4DeafEnvContext,
  userConfig: EnvironmentOptions = {}
): EnvironmentOptions {
  const { reporting } = context;

  return mergeConfig(
    {
      ...vr4deafBase(),
      resolve: {
        conditions: ["node", "vr4deaf-admin", "mbtq", "import", "default"],
        noExternal: ["deafauth-paseto", "fibronrose-sdk"],
      },
      define: {
        ...vr4deafBase().define,
        __VR4DEAF_TIER__:           JSON.stringify("vr_admin" satisfies VR4DeafTier),
        __MBTQ_AUDIT_ENABLED__:     "true",
        __VR4DEAF_RSA911__:         "true",
        __VR4DEAF_SUNSET_GATE__:    "true",      // Admin must approve case closure
        __VR4DEAF_AGENCY_CODE__:    JSON.stringify(reporting?.agencyCode ?? ""),
        __VR4DEAF_FISCAL_YEAR__:    JSON.stringify(reporting?.fiscalYear ?? ""),
        __VR4DEAF_STATE_ENDPOINT__: JSON.stringify(reporting?.stateVREndpoint ?? ""),
        __VR4DEAF_FEDERAL_ENDPOINT__: JSON.stringify(reporting?.rsa911Endpoint ?? ""),
      },
      dev: {
        createEnvironment(name: string, config: ResolvedConfig) {
          return new DevEnvironment(name, config, {
            hot: false, // No HMR in admin — stability required
          });
        },
      },
      build: {
        outDir: "dist/vr4deaf/admin",
        ssr: true,
        createEnvironment(name: string, config: ResolvedConfig) {
          return new BuildEnvironment(name, config);
        },
      },
    } satisfies EnvironmentOptions,
    userConfig
  );
}

// ─── EDGE ENV — ASL Video + Caption Injection ─────────────────────────────────
/**
 * Cloudflare workerd edge for vr4deaf.org.
 * Primary job: ASL video stream proxying + caption injection.
 * vr4deaf.org is the main ASL video consumer in the MBTQ ecosystem —
 * more video-intensive than mbtq.dev, dedicated edge environment needed.
 *
 * @swap-for vite-environment-workerd when Cloudflare target is wired
 */
export function createVR4DeafEdgeEnvironment(
  userConfig: EnvironmentOptions = {}
): EnvironmentOptions {
  return mergeConfig(
    {
      ...vr4deafBase(),
      resolve: {
        conditions: ["workerd", "worker", "browser", "vr4deaf-edge", "import", "default"],
        external: ["node:*", "cloudflare:*"],
      },
      define: {
        ...vr4deafBase().define,
        __VR4DEAF_TIER__:       JSON.stringify("builder" satisfies VR4DeafTier),
        __VR4DEAF_EDGE__:       "true",
        __VR4DEAF_ASL_STREAM__: "true",
        __VR4DEAF_CAPTION_INJECT__: "true",
        // vr4deaf.org edge serves captions — never optional, always injected
        __VR4DEAF_CAPTION_ALWAYS_ON__: "true",
      },
      dev: {
        createEnvironment(name: string, config: ResolvedConfig) {
          return new DevEnvironment(name, config, { hot: true });
        },
      },
      build: {
        outDir: "dist/vr4deaf/edge",
        createEnvironment(name: string, config: ResolvedConfig) {
          return new BuildEnvironment(name, config);
        },
      },
    } satisfies EnvironmentOptions,
    userConfig
  );
}

// ═══════════════════════════════════════════════════════════════════════════════
// VR4DEAF VITE CONFIG
// ═══════════════════════════════════════════════════════════════════════════════

export default defineConfig(({ mode }) => {
  const env = loadEnv(mode, process.cwd(), "VR4DEAF_");

  /**
   * Required .env keys for vr4deaf.org:
   *   VR4DEAF_AGENCY_CODE          e.g. CA-DVR · TX-TWC-VR · NY-ACCES-VR
   *   VR4DEAF_FISCAL_YEAR          e.g. FY2025
   *   VR4DEAF_STATE_ENDPOINT       State VR agency reporting URL
   *   VR4DEAF_RSA911_ENDPOINT      RSA-911 federal endpoint (ED/RSA)
   *   VR4DEAF_PASETO_PUBKEY        PASETO v4 public key (base64)
   */
  const reporting: VR4DeafReporting = {
    agencyCode:       env.VR4DEAF_AGENCY_CODE       ?? "DEV-VR",
    fiscalYear:       env.VR4DEAF_FISCAL_YEAR        ?? "FY2025",
    stateVREndpoint:  env.VR4DEAF_STATE_ENDPOINT     ?? "https://localhost:9010/vr/state",
    rsa911Endpoint:   env.VR4DEAF_RSA911_ENDPOINT    ?? "https://localhost:9010/rsa911/federal",
    pasetoPublicKey:  env.VR4DEAF_PASETO_PUBKEY       ?? "dev-key-replace-in-prod",
  };

  const adminContext: VR4DeafEnvContext = {
    tier: "vr_admin",
    auditLog: vr4deafAuditLog,
    reporting,
  };

  const counselorContext: VR4DeafEnvContext = {
    tier: "counselor",
    auditLog: vr4deafAuditLog,
    // Counselors don't submit to RSA-911 directly — routes through admin
  };

  return {
    plugins: [
      react(),
      tsconfigPaths(),

      // ── RSA-911 FLUSH PLUGIN ──────────────────────────────────────────────
      // Drains audit queue and submits RSA-911 records at build time (production)
      {
        name: "vr4deaf-rsa911-flush",
        buildEnd: async () => {
          if (mode !== "production") return;
          if (auditQueue.length === 0) return;

          const { state, federal } = await submitRSA911(auditQueue, reporting);
          console.log(`[VR4DEAF RSA-911] State: ${state?.status ?? "failed"} · Federal: ${federal?.status ?? "failed"}`);
          auditQueue.length = 0;
        },
      },

      // ── CAPTION ENFORCEMENT PLUGIN ────────────────────────────────────────
      // Hard error (not warning) if caption is ever made optional on vr4deaf.org.
      // This is a Deaf-first platform — captions are never opt-in.
      {
        name: "vr4deaf-caption-enforcement",
        transform(code: string, id: string) {
          if (!id.includes("vr4deaf") && !id.includes("src/")) return;
          if (!id.endsWith(".tsx") && !id.endsWith(".jsx")) return;

          // Patterns that hide or make captions optional — hard error
          const violations = [
            { pattern: /captionVisible.*=.*false/,   msg: "captionVisible must default to TRUE on vr4deaf.org" },
            { pattern: /showCaptions.*=.*false/,     msg: "showCaptions must default to TRUE on vr4deaf.org" },
            { pattern: /captions.*optional/i,        msg: "Captions are never optional on vr4deaf.org" },
            { pattern: /onlyIf.*deaf/i,              msg: "Do not gate captions behind deaf mode check — always show" },
          ];

          for (const { pattern, msg } of violations) {
            if (pattern.test(code)) {
              this.error(`[VR4DEAF CAPTION] ${msg} — in ${id}`);
            }
          }
        },
      },

      // ── HOH VISUAL ENFORCEMENT ────────────────────────────────────────────
      {
        name: "vr4deaf-hoh-lint",
        transform(code: string, id: string) {
          if (!id.endsWith(".tsx") && !id.endsWith(".jsx")) return;

          const audioGates = [/new Audio\(/, /AudioContext\(/, /SpeechSynthesisUtterance\(/];
          const hasVisual = code.includes("flashVisual") || code.includes("hohMode") || code.includes("captionVisible");

          for (const pattern of audioGates) {
            if (pattern.test(code) && !hasVisual) {
              this.warn(`[VR4DEAF HOH] Audio gate in ${id} without visual fallback — Deaf users will miss this`);
            }
          }
        },
      },
    ],

    environments: {
      // Individual Deaf/HoH users
      client: createVR4DeafClientEnvironment(),

      // VR counselors — caseload management, module generators
      counselor: createVR4DeafCounselorEnvironment(counselorContext, {
        build: { outDir: "dist/vr4deaf/counselor" },
      }),

      // State VR agency admins — RSA-911, case approval, sunset gate
      admin: createVR4DeafAdminEnvironment(adminContext, {
        build: { outDir: "dist/vr4deaf/admin" },
      }),

      // Edge — ASL video + caption injection (Cloudflare workerd)
      edge: createVR4DeafEdgeEnvironment({
        build: { outDir: "dist/vr4deaf/edge" },
      }),
    },

    build: {
      outDir: "dist/vr4deaf",
    },

    server: {
      port: 4001, // Different port from mbtq.dev (4000)
    },

    resolve: {
      alias: {
        "@vr4deaf/client":    "/src/client",
        "@vr4deaf/counselor": "/src/counselor",
        "@vr4deaf/admin":     "/src/admin",
        "@vr4deaf/edge":      "/src/edge",
        "@vr4deaf/shared":    "/src/shared",
        "@vr4deaf/lifecycle": "/src/lifecycle",
        "@vr4deaf/reporting": "/src/reporting",
        "@vr4deaf/video":     "/src/video",       // PinkSync ASL video consumer
        "@vr4deaf/captions":  "/src/captions",    // Caption injection layer
        // Shared with mbtq.dev via @mbtq/ scoped packages
        "@mbtq/deafauth":   "../../mbtq.dev/packages/deafauth",
        "@mbtq/pinksync":   "../../mbtq.dev/packages/pinksync",
        "@mbtq/fibronrose": "../../mbtq.dev/packages/fibronrose",
        "@mbtq/magician-core": "../../mbtq.dev/packages/magician-core",
      },
    },

    define: {
      __VR4DEAF_VERSION__:  JSON.stringify("2.0.0"),
      __VR4DEAF_DOMAIN__:   JSON.stringify("vr4deaf.org"),
      __MBTQ_UNIVERSE__:    JSON.stringify("mbtquniverse.com"),
      // vr4deaf.org is a consumer of mbtq.dev's trust mesh
      // It does NOT host the trust mesh — it consumes it
      __MBTQ_TRUST_MESH_URL__: JSON.stringify("https://api.mbtq.dev"),
      __MBTQ_PINKSYNC_URL__:   JSON.stringify("https://pinksync.mbtq.dev"),
      __MBTQ_DEAFAUTH_URL__:   JSON.stringify("https://deafauth.mbtq.dev"),
    },
  };
});

/**
 * ─── VR4DEAF.ORG vs MBTQ.DEV BOUNDARY ──────────────────────────────────────
 *
 * vr4deaf.org OWNS:
 *   - VR case lifecycle (referral → IPE → services → milestones → employment → closure)
 *   - RSA-911 reporting pipeline
 *   - Deaf/HoH client-facing experience
 *   - VR counselor caseload tools
 *   - State VR agency admin portal
 *   - ASL video consumer layer (edge)
 *   - Caption injection (always-on, never optional)
 *   - Case closure / lifetime support registration
 *
 * vr4deaf.org CONSUMES from mbtq.dev:
 *   - DeafAUTH (identity + PASETO tokens)
 *   - PinkSync (ASL video stream + WebSocket gateway)
 *   - FibronRose (trust scoring + blockchain anchor)
 *   - @mbtq/magician-core (360Magicians portable module)
 *
 * vr4deaf.org does NOT:
 *   - Host mbtq.dev infrastructure
 *   - Run its own trust mesh
 *   - Duplicate DeafAUTH / FibronRose logic
 *   - Handle SBA or Workforce (those are mbtq.dev admin environments)
 *
 * Port split:
 *   mbtq.dev   → 4000 (dev)
 *   vr4deaf.org → 4001 (dev)
 *
 * Build output split:
 *   mbtq.dev   → dist/  (root of mbtq.dev monorepo)
 *   vr4deaf.org → dist/vr4deaf/  (root of vr4deaf.org repo)
 */
